# ==============================================================================
# HUB COMMERCIALE - CONFIGURAZIONE VARIABILI D'AMBIENTE
# ==============================================================================

# 1. DATABASE TURSO (SQLite Edge distribuito)
# In sviluppo locale opzionale (usa file:data/commercial.sqlite se non specificato)
# In produzione su Vercel OBBLIGATORIO
TURSO_DATABASE_URL="libsql://tuo-database-org.turso.io"
TURSO_AUTH_TOKEN="il-tuo-turso-auth-token"

# 2. DOMINIO APPLICAZIONE (per WebAuthn Passkeys e link nelle email)
# In locale: http://localhost:3000 (predefinito se vuoto)
# In produzione su Vercel: l'URL HTTPS completo del deployment
APP_ORIGIN="https://tuo-dominio.vercel.app"

# 3. VERIFICA EMAIL E RECUPERO PASSWORD (SMTP Standard)
# Esempio Gmail (richiede 'Password per le app' con 2FA attivo su myaccount.google.com):
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="tuo-indirizzo@gmail.com"
# SMTP_PASSWORD="password_per_le_app_di_16_caratteri"
# SMTP_FROM="Hub Commerciale <tuo-indirizzo@gmail.com>"
#
# Esempio Brevo / SendGrid / Dominio Custom:
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="tua-email-o-login@azienda.it"
SMTP_PASSWORD="tua-password-smtp"
SMTP_FROM="Hub Commerciale <no-reply@azienda.it>"

# 4. INTEGRAZIONE AGENTI MCP HTTP (Opzionale)
# Se lasciati vuoti, l'endpoint /api/mcp rimane chiuso e sicuro (503 Service Unavailable)
MCP_OWNER_USER_ID="id-del-workspace-da-impostazioni"
MCP_API_TOKEN="chiave-segreta-casuale-lunga-per-agenti"

# Provider REST: usare esclusivamente mittenti autorizzati/verificati.
# Resend: il dominio di RESEND_FROM deve essere verificato nel pannello Resend.
# onboarding@resend.dev è solo per test all'indirizzo del proprietario.
RESEND_API_KEY=""
RESEND_FROM=""
BREVO_API_KEY=""
